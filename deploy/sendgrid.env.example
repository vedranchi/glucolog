# Copy to the repo root as `sendgrid.env` on the VM:
#   cp deploy/sendgrid.env.example sendgrid.env
# REQUIRED: settings.py reads SENDGRID_API_KEY at import time (password-reset
# email), so the app will not boot without it. Never commit the real file.

SENDGRID_API_KEY=SG.CHANGE_ME
DEFAULT_FROM_EMAIL=you@example.com
SERVER_EMAIL=you@example.com
