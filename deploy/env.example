# Copy to the repo root as `.env` on the VM and fill in real values:
#   cp deploy/env.example .env
# This file is read by compose (for ${DB_*} / ${SITE_DOMAIN} interpolation) and
# injected into the web container (env_file). Never commit the real .env.

# ---- Django ----
DEBUG=False
# Generate with:
#   python3 -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
SECRET_KEY=CHANGE_ME
ALLOWED_HOSTS=glucoread.com
CSRF_TRUSTED_ORIGINS=https://glucoread.com

# ---- Reverse proxy / TLS ----
# Caddy auto-provisions a Let's Encrypt cert for this exact domain.
# The canonical hostname Caddy serves the app on. Legacy hostnames are
# redirected to it by a separate block in deploy/Caddyfile, so they must NOT
# be listed here — a hostname in both places is a fatal Caddy config error.
SITE_DOMAIN=glucoread.com

# ---- Database ----
# compose interpolates DB_* into the `db` service; the web app connects via
# DATABASE_URL. The password in DATABASE_URL MUST match DB_PASSWORD.
DB_NAME=glucolog
DB_USER=glucolog
DB_PASSWORD=CHANGE_ME_strong_db_password
DATABASE_URL=postgres://glucolog:CHANGE_ME_strong_db_password@db:5432/glucolog

# ---- First-boot HTTP-only smoke test ONLY (before TLS is up) ----
# Leave commented for normal HTTPS operation. If you bring the app up on http
# before Caddy has a cert, uncomment to avoid the SSL-redirect loop.
# SECURE_SSL_REDIRECT=False

# Recipients for unhandled 500 emails (DEBUG=False only). Comma separated;
# either "Name <addr@example.com>" or a bare address. Leave blank and
# production errors are logged to stdout but nobody is told.
ADMINS=Vedran <you@example.com>

# Root/django log level. Read by core/settings.py LOGGING.
DJANGO_LOGLEVEL=INFO
