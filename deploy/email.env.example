# Email credentials — copy to the repo root as `email.env` and fill in.
# Never commit the real file; it is gitignored and excluded from the image.
#
# Keys are provider-neutral on purpose. Switching providers is an env change,
# not a code change.

# --- Current: SMTP (Gmail) ---
# Works without owning a domain, which matters while the app is on a DuckDNS
# subdomain: DuckDNS cannot host the DKIM records that hosted email APIs
# require, so domain verification is not possible there.
#
# EMAIL_HOST_PASSWORD must be a Gmail App Password, not the account password.
# Generate one at https://myaccount.google.com/apppasswords (requires 2FA).
# Gmail allows roughly 500 messages/day.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=you@gmail.com
EMAIL_HOST_PASSWORD=CHANGE_ME_app_password

# Shown as the sender. Leave matching EMAIL_HOST_USER for SMTP — a mismatched
# From address will be rewritten or rejected by most providers.
DEFAULT_FROM_EMAIL=you@gmail.com
SERVER_EMAIL=you@gmail.com

# --- Later: Resend, once a real domain exists ---
# django-anymail is already installed, so this needs no new dependency. Verify
# the domain in Resend first (SPF + DKIM records), then swap these lines in and
# drop the SMTP block above.
#
# EMAIL_BACKEND=anymail.backends.resend.EmailBackend
# RESEND_API_KEY=re_CHANGE_ME
# DEFAULT_FROM_EMAIL=noreply@yourdomain.tld
#
# Note: anymail reads its key from a Django setting, not the environment, so
# this one also needs a line in core/settings.py:
#   ANYMAIL = {"RESEND_API_KEY": email_env("RESEND_API_KEY", default="")}
