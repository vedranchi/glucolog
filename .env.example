# Copy to .env and fill in. Only these are needed to run locally.
#
# NOTE: docker compose interpolates `$` in this file — escape any literal
# dollar sign in a value as `$$`, or it will be silently truncated.

# Generate one with:
#   ./env/bin/python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=replace-me

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_LOGLEVEL=INFO

# Postgres. DB_* configure the `db` container; Django itself reads only
# DATABASE_URL, so keep the two in sync.
DB_NAME=glucolog
DB_USER=glucolog
DB_PASSWORD=glucolog
DB_PORT=5433
DATABASE_URL=postgres://glucolog:glucolog@127.0.0.1:5433/glucolog

# Email is optional in dev — DEBUG=True uses Django's console backend, so
# password-reset mails print to the terminal. For real SMTP, see email.env.
