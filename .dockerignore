# Keep secrets and local cruft out of the image build context.
# Secrets are injected at runtime via compose `env_file`, never baked in.
.git
.gitignore
env/
__pycache__/
*.pyc
*.pyo
*.pyd
staticfiles/
media/
.env
.env.*
backups/
email.env
sendgrid.env
.claude/
*.sqlite3
# HANDOFF.md is gitignored, so CI never sees it — but a local or on-VM
# `docker build` would bake the VM address, SSH key path and demo credentials
# straight into the image.
HANDOFF.md
.agents/
TODO
# ~1.3 MB of README screenshots the running app never serves
docs/
.github/
node_modules/
.DS_Store
